# Serves the app and proxies the API on one origin, so cookies are first-party and no CORS
# is ever needed (ADR 0011, ADR 0013).
#
# This file is the only site configuration. Per installation, synapsectl sets the environment
# variables below and may add a TLS snippet under /etc/caddy/site.d/ (ADR 0012). Without them,
# the defaults serve plain HTTP on port 8080, for local testing only.
{
	admin off
	# The port that answers plain HTTP (and redirects to HTTPS). The HTTPS port is part of the
	# site address instead: Caddy leaves a port equal to its https_port option out of redirects,
	# assuming an outside mapping to 443 that installations do not have.
	http_port {$SYNAPSE_HTTP_PORT:8080}
}

# Liveness for the container health check. This port is never published.
http://:8099 {
	respond "ok" 200
}

{$SYNAPSE_SITE_ADDRESS::8080} {
	# The TLS directive for this installation (internal CA, provided certificate or ACME).
	import /etc/caddy/site.d/*.caddy

	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), publickey-credentials-create=(self), publickey-credentials-get=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# Chat answers are streamed; forward every chunk immediately.
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# Hashed build assets never change, so they can be cached for a long time;
		# index.html must always be fresh so a new release is picked up.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
